LOCAL_LM_DATA_DIR=./data
LOCAL_LM_WEB_DIST_DIR=./apps/web/dist
LOCAL_LM_HOST=127.0.0.1
LOCAL_LM_PORT=12340
LOCAL_LM_DEV=false
LOCAL_LM_CHAT_ENGINE=mock
LOCAL_LM_MEDIA_ENGINE=mock
LOCAL_LM_LLAMA_URL=http://127.0.0.1:12341
LOCAL_LM_COMFY_URL=http://127.0.0.1:8188
# Optional managed-worker paths. Leave unset when engines are started externally.
LOCAL_LM_LLAMA_EXECUTABLE=
LOCAL_LM_COMFY_EXECUTABLE=
LOCAL_LM_COMFY_DIRECTORY=
# Interrupt a ComfyUI run only when its websocket reports no activity for this long.
LOCAL_LM_COMFY_INACTIVITY_SECONDS=600
LOCAL_LM_WORKER_STARTUP_SECONDS=60
LOCAL_LM_WORKER_SHUTDOWN_SECONDS=10
LOCAL_LM_AUTO_UNLOAD_CHAT_FOR_MEDIA=true
LOCAL_LM_VIDEO_CONFIRMATION_WORK_UNITS=500000000
# Optional non-persistent fallback. Prefer the Settings credential-vault control.
LOCAL_LM_HF_TOKEN=
LOCAL_LM_ARTIFACT_RETENTION_DAYS=30
LOCAL_LM_TEMPORARY_RETENTION_HOURS=24
LOCAL_LM_STORAGE_WARNING_FREE_BYTES=10737418240
LOCAL_LM_BACKUP_DAILY_COUNT=7
LOCAL_LM_BACKUP_WEEKLY_COUNT=4
